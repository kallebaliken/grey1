local camera_api = require "world.camera"
local view_model = require "main.view_model"
local TILE_SIZE = 32
local NODE_CAPACITY = 1024

local function box(self, index, x, y, color, size)
    local node = self.nodes[index]
    if not node then
        node = gui.new_box_node(vmath.vector3(), vmath.vector3())
        gui.set_layer(node, "world")
        self.nodes[index] = node
    end
    gui.set_enabled(node, true)
    -- Semantic order is represented by the already-sorted node sequence, never GUI Z.
    gui.set_position(node, vmath.vector3(x, y, 0))
    gui.set_size(node, vmath.vector3(size or 30, size or 30, 0))
    gui.set_color(node, vmath.vector4(color[1], color[2], color[3], color[4] or 1))
    if index > 1 then gui.move_above(node, self.nodes[index - 1]) end
end

function init(self)
    self.nodes = {}
    self.camera = camera_api.new(960, 640)
end

function on_message(self, message_id, message)
    if message_id ~= hash("render_world") then return end
    message = view_model.frame
    if not message then return end
    camera_api.follow(self.camera, message.player_x, message.player_y)
    for index, command in ipairs(message.commands) do
        local x, y = camera_api.project(self.camera, command.x, command.y, TILE_SIZE)
        box(self, index, x, y, command.color, command.size or 31)
    end
    for index = #message.commands + 1, #self.nodes do gui.set_enabled(self.nodes[index], false) end
    gui.set_text(gui.get_node("status"), string.format(
        "Greyhaven | Move: WASD/arrows | E use | K attack | L weapon | O armor | P rat attack | F1 debug | F5 save | F8 reset | F9 load | %s", message.notice))
    local debug = gui.get_node("debug")
    gui.set_enabled(debug, message.debug_visible)
    gui.set_text(debug, string.format("actor: %s (%s)  tile: %d,%d,%d  facing: %s  inspect: %+d\nPlayer HP: %s Attack: %d %s Weapon: %s Cooldown: %.2f | Armor: %d %s\nmonster_test_rat HP: %s dead: %s | Last attack: %s\nrender commands: %d  active nodes: %d  node capacity: %d\nnpc_test_villager path: %s  remaining: %d  next: %s\ntile objects: %s\nfront: %s\ninventory: %s\nequipment: %s\nchunk: %s  revealed roof: %s",
        message.actor_id, message.actor_type, message.logical_x, message.logical_y, message.player_z, message.facing,
        message.inspection_offset, message.player_health, message.player_attack, message.player_attack_source,
        message.player_weapon, message.player_attack_cooldown, message.player_armor, message.player_armor_sources,
        message.rat_health, tostring(message.rat_dead), message.last_attack,
        message.render_commands, #message.commands, NODE_CAPACITY,
        message.npc_path_status, message.npc_path_remaining, message.npc_path_next,
        message.tile_objects, message.target, message.inventory, message.equipment,
        message.chunk, message.roof_group))
end

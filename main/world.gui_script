local view_model = require "main.view_model"
local equipment_panel = require "ui.equipment_panel"
local inventory_panel = require "ui.inventory_panel"
local GUI_NODE_CAPACITY = 112
local SLOT_COLOR = vmath.vector4(0.025, 0.03, 0.04, 1)
local HOVER_COLOR = vmath.vector4(0.22, 0.28, 0.34, 1)
local SELECTED_COLOR = vmath.vector4(0.42, 0.32, 0.12, 1)
local HOVER_SELECTED_COLOR = vmath.vector4(0.52, 0.43, 0.20, 1)
local DRAG_VALID_COLOR = vmath.vector4(0.12, 0.38, 0.22, 1)
local DRAG_INVALID_COLOR = vmath.vector4(0.42, 0.14, 0.12, 1)
local DRAG_SWAP_COLOR = vmath.vector4(0.34, 0.20, 0.46, 1)
local DRAG_MERGE_COLOR = vmath.vector4(0.10, 0.46, 0.30, 1)
local DRAG_SOURCE_COLOR = vmath.vector4(0.10, 0.10, 0.11, 1)
local INVENTORY_PANEL_COLOR = vmath.vector4(0.065, 0.078, 0.095, 1)

local function drag_target_color(drag)
    if not drag.target_valid then return DRAG_INVALID_COLOR end
    if drag.target_action == "inventory_swap" then return DRAG_SWAP_COLOR end
    if drag.target_action == "inventory_merge" then return DRAG_MERGE_COLOR end
    return DRAG_VALID_COLOR
end

local function node_for_target(target_name)
    local equipment_slot = target_name:match("^equipment%.(.+)$")
    local inventory_slot = target_name:match("^inventory%.slot%.(%d+)$")
    if equipment_slot then return "equipment_" .. equipment_slot .. "_slot" end
    if inventory_slot then return "inventory_" .. inventory_slot .. "_slot" end
end

local function drag_source_name(drag)
    if not drag then return "none" end
    if drag.source.type == "equipment_slot" then return "equipment." .. drag.source.slot end
    return "inventory.slot." .. drag.source.index
end

local function drag_target_name(drag)
    if not drag or not drag.target then return "none" end
    if drag.target.target_type == "equipment_slot" then return "equipment." .. drag.target.slot end
    if drag.target.target_type == "inventory_slot" then return "inventory.slot." .. drag.target.index end
    return drag.target.target_type
end

local function update_highlights(self, hover_target, selected_target, drag, drag_slots)
    local slot_parts = {}
    for slot, status in pairs(drag_slots or {}) do slot_parts[#slot_parts + 1] = slot .. status end
    table.sort(slot_parts)
    local fingerprint = table.concat({ hover_target, selected_target, drag_source_name(drag),
        drag_target_name(drag), drag and tostring(drag.target_valid) or "",
        drag and (drag.target_action or "") or "", table.concat(slot_parts, ",") }, "|")
    if self.highlight_fingerprint == fingerprint then return end
    self.highlight_fingerprint = fingerprint
    if self.hover_node then gui.set_color(gui.get_node(self.hover_node), SLOT_COLOR) end
    if self.selected_node then gui.set_color(gui.get_node(self.selected_node), SLOT_COLOR) end
    for _, node_id in ipairs(self.drag_nodes or {}) do gui.set_color(gui.get_node(node_id), SLOT_COLOR) end
    if self.drag_inventory_panel then gui.set_color(gui.get_node("inventory_panel"), INVENTORY_PANEL_COLOR) end
    self.drag_nodes, self.drag_inventory_panel = {}, false
    self.hover_node, self.selected_node = node_for_target(hover_target), node_for_target(selected_target)
    for slot, status in pairs(drag_slots or {}) do
        local node_id = "equipment_" .. slot .. "_slot"
        self.drag_nodes[#self.drag_nodes + 1] = node_id
        gui.set_color(gui.get_node(node_id), status == "valid" and DRAG_VALID_COLOR or DRAG_INVALID_COLOR)
    end
    if self.selected_node then gui.set_color(gui.get_node(self.selected_node), SELECTED_COLOR) end
    if drag and drag.active then
        local source_node = node_for_target(drag_source_name(drag))
        if source_node then self.drag_nodes[#self.drag_nodes + 1] = source_node
            gui.set_color(gui.get_node(source_node), DRAG_SOURCE_COLOR) end
        local target_name = drag_target_name(drag)
        if target_name == "inventory_panel" then
            self.drag_inventory_panel = true
            gui.set_color(gui.get_node("inventory_panel"), drag_target_color(drag))
        else
            local target_node = node_for_target(target_name)
            if target_node then self.drag_nodes[#self.drag_nodes + 1] = target_node
                gui.set_color(gui.get_node(target_node), drag_target_color(drag)) end
        end
    end
    if self.hover_node and not (drag and drag.active) then
        gui.set_color(gui.get_node(self.hover_node), self.hover_node == self.selected_node
            and HOVER_SELECTED_COLOR or HOVER_COLOR)
    end
end

local function update_drag_ghost(self, drag)
    local ghost = gui.get_node("drag_ghost")
    local visible = drag ~= nil and drag.active and drag.pointer_x ~= nil and drag.pointer_y ~= nil
    gui.set_enabled(ghost, visible)
    if not visible then return end
    gui.set_position(ghost, vmath.vector3(drag.pointer_x, drag.pointer_y, 0))
    if self.drag_animation ~= drag.animation then
        self.drag_animation = drag.animation
        gui.play_flipbook(ghost, hash(drag.animation or "fallback_01"))
    end
end

local function update_equipment(self, snapshot)
    local fingerprint = equipment_panel.fingerprint(snapshot)
    if self.equipment_fingerprint == fingerprint then return end
    self.equipment_fingerprint = fingerprint
    for _, entry in ipairs(snapshot.entries) do
        local prefix = "equipment_" .. entry.slot
        local icon, label = gui.get_node(prefix .. "_icon"), gui.get_node(prefix .. "_label")
        local occupied = entry.item_id ~= nil
        gui.set_enabled(icon, occupied)
        gui.set_enabled(label, not occupied)
        if occupied then gui.play_flipbook(icon, hash(entry.animation)) end
    end
end

local function update_inventory(self, snapshot)
    local fingerprint = inventory_panel.fingerprint(snapshot)
    if self.inventory_fingerprint == fingerprint then return end
    self.inventory_fingerprint = fingerprint
    for index = 1, inventory_panel.VISIBLE_SLOTS do
        local entry = snapshot.entries[index]
        local prefix = "inventory_" .. index
        local icon = gui.get_node(prefix .. "_icon")
        local quantity = gui.get_node(prefix .. "_quantity")
        gui.set_enabled(icon, entry ~= nil)
        gui.set_enabled(quantity, entry ~= nil and entry.show_quantity)
        if entry then
            gui.play_flipbook(icon, hash(entry.animation))
            gui.set_text(quantity, entry.show_quantity and tostring(entry.quantity) or "")
        end
    end
    gui.set_text(gui.get_node("inventory_title"), string.format("INVENTORY  %d/%d%s",
        snapshot.occupied, snapshot.capacity, snapshot.overflow > 0 and ("  +" .. snapshot.overflow .. " MORE") or ""))
end

function init(self)
end

function on_message(self, message_id, message)
    if message_id ~= hash("render_world") then return end
    message = view_model.frame
    if not message then return end
    gui.set_text(gui.get_node("status"), "GREYHAVEN\n" .. message.notice)
    gui.set_text(gui.get_node("bottom_content"), message.notice ~= "" and message.notice or "Greyhaven ready.")
    update_equipment(self, message.equipment_ui)
    update_inventory(self, message.inventory_ui)
    update_highlights(self, message.mouse_hover_name, message.selected_target, message.drag, message.drag_slots)
    update_drag_ghost(self, message.drag)
    local debug = gui.get_node("debug")
    gui.set_enabled(debug, message.debug_visible)
    gui.set_enabled(gui.get_node("control_help"), message.debug_visible)
    gui.set_text(debug, string.format("actor: %s (%s) faction: %s  tile: %d,%d,%d  facing: %s  inspect: %+d\nPlayer HP: %s Attack: %d %s Weapon: %s Cooldown: %.2f | Armor: %d %s\nmonster_test_rat definition: %s type: %s faction: %s relationship: %s HP: %s dead: %s | Last attack: %s\nRat sight: %d | Perceives: %s\nnpc_test_villager definition: %s type: %s faction: %s relationship: %s\ndialogue: %s speaker: %s definition: %s node: %s\nflags: met_test_villager=%s test_dialogue=%s\nQuest: %s status: %s investigate: %d/%d | Last binding: %s\nMouse physical: %s | Mouse virtual: %s | Region: %s\nHover: %s | Clicked: %s%s\nSelected item: %s\nDrag: %s\nLast inventory drop: %s\nCamera zoom: %dx | Visible tiles: ~%.0fx%.0f\nRender commands: %d (ground %d objects %d multi %d items %d actors %d roofs %d)\nWorld sprites: %d | Sprite max: %d | Collection max: %d\nCreated: %d reused: %d removed: %d failures: %d deferred: %d | GUI nodes: %d\nnpc_test_villager path: %s  remaining: %d  next: %s\ntile objects: %s\nfront: %s\ninventory: %s\nequipment: %s\nEquipment UI: %s\nInventory UI: %s\nchunk: %s  revealed roof: %s",
        message.actor_id, message.actor_type, message.player_faction,
        message.logical_x, message.logical_y, message.player_z, message.facing,
        message.inspection_offset, message.player_health, message.player_attack, message.player_attack_source,
        message.player_weapon, message.player_attack_cooldown, message.player_armor, message.player_armor_sources,
        message.rat_definition, message.rat_type, message.rat_faction, message.rat_relationship,
        message.rat_health, tostring(message.rat_dead), message.last_attack,
        message.rat_sight, message.rat_perceives,
        message.villager_definition, message.villager_type, message.villager_faction, message.villager_relationship,
        message.dialogue_active and "active" or "none", message.dialogue_speaker,
        message.dialogue_definition, message.dialogue_node,
        tostring(message.met_villager_flag), tostring(message.test_dialogue_flag),
        message.quest_title, message.quest_status, message.quest_progress, message.quest_target,
        message.last_binding,
        message.mouse_physical, message.mouse_virtual, message.mouse_region, message.mouse_hover,
        message.mouse_clicked, message.mouse_click_blocked and " (dialogue blocked)" or "",
        message.selected_item,
        message.drag_diagnostics,
        message.last_inventory_drop,
        message.camera_zoom, message.visible_tiles_width, message.visible_tiles_height,
        message.render_commands, message.render_ground, message.render_objects, message.render_multi_piece,
        message.render_items, message.render_actors, message.render_roofs,
        message.sprite_instances, message.sprite_capacity, message.collection_capacity,
        message.sprite_created, message.sprite_reused, message.sprite_removed, message.sprite_failures,
        message.sprite_deferred, GUI_NODE_CAPACITY,
        message.npc_path_status, message.npc_path_remaining, message.npc_path_next,
        message.tile_objects, message.target, message.inventory, message.equipment,
        message.equipment_ui_diagnostics, message.inventory_ui_diagnostics, message.chunk, message.roof_group))
    local dialogue_panel, dialogue_text = gui.get_node("dialogue_panel"), gui.get_node("dialogue_text")
    gui.set_enabled(dialogue_panel, message.dialogue_active)
    gui.set_enabled(dialogue_text, message.dialogue_active)
    gui.set_text(dialogue_text, message.dialogue_text)
end

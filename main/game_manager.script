local events = require "core.events"
local map_loader = require "world.map_loader"
local registry_api = require "world.object_registry"
local world_api = require "world.world"
local roofs = require "world.roofs"
local chunks = require "world.chunks"
local renderer = require "render.world_renderer"
local player_api = require "actors.player"
local movement = require "simulation.movement"
local interaction = require "simulation.interaction"
local actions = require "simulation.actions"
local state_api = require "state.world_state"
local save_data = require "state.save_data"
local save_manager = require "state.save_manager"
local definitions = require "objects.object_defs"
local item_definitions = require "items.item_defs"
local item_registry_api = require "items.item_registry"
local inventory_api = require "items.inventory"
local equipment_api = require "items.equipment"
local equipment_panel = require "ui.equipment_panel"
local inventory_panel = require "ui.inventory_panel"
local item_transfers = require "simulation.item_transfers"
local pathfinding = require "simulation.pathfinding"
local movement_controller = require "simulation.movement_controller"
local combat_registry = require "combat.registry"
local attacks = require "combat.attacks"
local creature_definitions = require "creatures.creature_defs"
local creature_registry_api = require "creatures.creature_registry"
local creatures = require "creatures.creatures"
local perception = require "simulation.perception"
local faction_definitions = require "factions.faction_defs"
local relationship_definitions = require "factions.relationship_defs"
local faction_registry_api = require "factions.faction_registry"
local factions = require "factions.factions"
local dialogue_definitions = require "dialogue.dialogue_defs"
local dialogue_registry_api = require "dialogue.dialogue_registry"
local dialogue = require "dialogue.dialogue"
local quest_definitions = require "quests.quest_defs"
local quest_registry_api = require "quests.quest_registry"
local quests = require "quests.quests"
local binding_definitions = require "event_bindings.binding_defs"
local binding_registry_api = require "event_bindings.binding_registry"
local event_bindings = require "event_bindings.event_bindings"
local view_model = require "main.view_model"
local viewport_api = require "render.viewport"
local command_diagnostics = require "render.command_diagnostics"
local sprite_diagnostics = require "render.sprite_diagnostics"
local camera_api = require "world.camera"
local layout = require "render.layout"
local input_dispatch = require "ui.input_dispatch"
local equipment_controller = require "ui.equipment_controller"
local item_selection = require "ui.item_selection"
local item_drag = require "ui.item_drag"

local LOGICAL_TILE_SIZE = 32
local CAMERA_ZOOM = sys.get_config_int("greyhaven.camera_zoom", camera_api.DEFAULT_ZOOM)
local CAMERA = camera_api.new(layout.WORLD.width, layout.WORLD.height, CAMERA_ZOOM,
    layout.WORLD.x, layout.WORLD.y)
local VIEW_WIDTH_TILES, VIEW_HEIGHT_TILES = camera_api.visible_tiles(CAMERA, LOGICAL_TILE_SIZE)
local VIEW_MARGIN_TILES = 2
local COLLECTION_CAPACITY = sys.get_config_int("collection.max_instances", 1024)
local SPRITE_CAPACITY = sys.get_config_int("sprite.max_count", 128)
local TEST_DIALOGUE_FLAG = "greyhaven.test_dialogue_flag"
local MET_VILLAGER_FLAG = "greyhaven.met_test_villager"

local function describe_tile(world, position)
    local names = {}
    for _, entry in ipairs(world:get_objects(position.x, position.y, position.z)) do names[#names + 1] = entry.instance.type end
    return #names > 0 and table.concat(names, ",") or "empty"
end


local function describe_inventory(inventory)
    local names = {}
    for _, item in ipairs(inventory_api.get_items(inventory)) do
        names[#names + 1] = string.format("%s:%s x%d", item.id, item.type, item.quantity)
    end
    return #names > 0 and table.concat(names, ",") or "empty"
end

local function describe_equipment(equipment)
    local names = {}
    for slot_id, item in pairs(equipment_api.get_items(equipment)) do
        names[#names + 1] = slot_id .. ":" .. item.id
    end
    table.sort(names)
    return #names > 0 and table.concat(names, ",") or "empty"
end

local function describe_perception(entries)
    local descriptions = {}
    for _, entry in ipairs(entries) do
        descriptions[#descriptions + 1] = string.format("%s [%d, %s]", entry.actor_id, entry.distance,
            entry.relationship or "unaffiliated")
    end
    return #descriptions > 0 and table.concat(descriptions, ", ") or "none"
end

local function render(self)
    local visual = movement.visual_position(self.player)
    local viewport = viewport_api.new(visual.x, visual.y, VIEW_WIDTH_TILES, VIEW_HEIGHT_TILES, VIEW_MARGIN_TILES)
    local commands, revealed = renderer.build(self.world, self.player, self.inspect_offset, viewport, self.creatures)
    local render_counts = command_diagnostics.summarize(commands)
    local sprite_stats = sprite_diagnostics.get()
    local target = interaction.find_target(self.world, self.player)
    local p = self.player.position
    local chunk_x, chunk_y = chunks.coordinates(p.x, p.y)
    local npc_id = "npc_test_villager"
    local npc_status = movement_controller.get_status(self.path_controller, npc_id) or "unavailable"
    local npc_remaining = movement_controller.get_remaining_steps(self.path_controller, npc_id) or 0
    local npc_next = movement_controller.get_next_target(self.path_controller, npc_id)
    local player_combat = combat_registry.get(self.combat, self.player.id)
    local rat_combat = combat_registry.get(self.combat, "monster_test_rat")
    local rat = self.world:get_actor("monster_test_rat")
    local villager = self.world:get_actor("npc_test_villager")
    local rat_definition = creatures.get_definition_id(self.creatures, rat.id)
    local villager_definition = creatures.get_definition_id(self.creatures, villager.id)
    local player_faction = factions.get_actor_faction(self.factions, self.player.id)
    local rat_faction = factions.get_actor_faction(self.factions, rat.id)
    local villager_faction = factions.get_actor_faction(self.factions, villager.id)
    local rat_relationship = factions.relationship_between_actors(self.factions, rat.id, self.player.id)
    local villager_relationship = factions.relationship_between_actors(self.factions, villager.id, self.player.id)
    local player_attack = attacks.get_profile(self.attacks, self.player.id)
    local player_damage = attacks.get_damage(self.attacks, self.player.id)
    local player_armor = attacks.get_armor(self.attacks, self.player.id)
    local equipment_ui = equipment_panel.snapshot(self.player.equipment, self.item_registry)
    local inventory_ui = inventory_panel.snapshot(self.player.inventory, self.item_registry)
    local pointer = self.pointer or { region = "outside" }
    local clicked_target = self.last_ui_intent and self.last_ui_intent.target
    local armor_sources = {}
    for _, source in ipairs(player_armor.sources) do
        armor_sources[#armor_sources + 1] = source.slot .. ":" .. source.item_type .. " [" .. source.item_id .. "]"
    end
    local last_attack = self.last_attack
    local conversation = dialogue.get_current(self.dialogue)
    if conversation then item_selection.clear(self.item_selection); item_drag.cancel(self.item_drag)
    else item_selection.reconcile(self.item_selection, equipment_ui, inventory_ui) end
    item_drag.reconcile(self.item_drag, equipment_ui, inventory_ui)
    local selected_item = item_selection.get_snapshot(self.item_selection)
    local drag = item_drag.get_snapshot(self.item_drag)
    local drag_slots = {}
    if drag and drag.active and drag.source.type == "inventory_slot" then
        local definition = self.item_registry:get(drag.item_type)
        local allowed = {}
        for _, slot in ipairs(definition.equipment and definition.equipment.slots or {}) do allowed[slot] = true end
        for _, entry in ipairs(equipment_ui.entries) do
            if allowed[entry.slot] then drag_slots[entry.slot] = entry.item_id and "blocked" or "valid" end
        end
    end
    local quest_definition = self.quest_registry:get("rat_problem")
    local quest_status = quests.get_status(self.quests, "rat_problem")
    local quest_progress = quests.get_objective_progress(self.quests, "rat_problem", "investigate") or 0
    local binding_results = event_bindings.get_last_results(self.event_bindings)
    local last_binding = binding_results[#binding_results]
    local rat_perception = perception.get_config(self.perception, rat.id)
    local rat_awareness = perception.get_awareness(self.perception, rat.id)
    local dialogue_text = ""
    if conversation then
        local lines = { conversation.speaker_name, "", conversation.text, "" }
        for index, choice in ipairs(conversation.choices) do
            lines[#lines + 1] = index .. ". " .. choice.text
        end
        lines[#lines + 1] = "Esc. Close"
        dialogue_text = table.concat(lines, "\n")
    end
    view_model.frame = { commands = commands,
        player_x = visual.x, player_y = visual.y,
        actor_id = self.player.id, actor_type = self.player.type,
        logical_x = p.x, logical_y = p.y, player_z = p.z, facing = self.player.facing,
        debug_visible = self.debug_visible, tile_objects = describe_tile(self.world, p),
        target = target and (target.id .. " (" .. target.type .. ")") or "none",
        inventory = describe_inventory(self.player.inventory),
        equipment = describe_equipment(self.player.equipment),
        equipment_ui = equipment_ui, equipment_ui_diagnostics = equipment_panel.describe(equipment_ui),
        inventory_ui = inventory_ui, inventory_ui_diagnostics = inventory_panel.describe(inventory_ui),
        mouse_physical = string.format("%d,%d", pointer.physical_x or 0, pointer.physical_y or 0),
        mouse_virtual = pointer.virtual_x and string.format("%.0f,%.0f", pointer.virtual_x, pointer.virtual_y)
            or "outside",
        mouse_region = pointer.region, mouse_hover_name = input_dispatch.target_name(pointer.target),
        mouse_hover = input_dispatch.describe_target(pointer.target),
        mouse_clicked = input_dispatch.describe_target(clicked_target),
        mouse_click_blocked = self.last_ui_intent and self.last_ui_intent.blocked or false,
        selected_target = item_selection.target_name(selected_item),
        selected_item = item_selection.describe(selected_item),
        drag = drag, drag_diagnostics = item_drag.describe(drag), drag_slots = drag_slots,
        chunk = chunk_x .. "," .. chunk_y, roof_group = next(revealed) or "none",
        inspection_offset = self.inspect_offset, notice = self.notice or "",
        render_commands = #commands, npc_path_status = npc_status, npc_path_remaining = npc_remaining,
        render_ground = render_counts.ground, render_objects = render_counts.world_objects,
        render_multi_piece = render_counts.multi_piece, render_items = render_counts.items,
        render_actors = render_counts.actors, render_roofs = render_counts.roofs,
        sprite_instances = sprite_stats.active, sprite_created = sprite_stats.created,
        sprite_reused = sprite_stats.reused, sprite_removed = sprite_stats.removed,
        sprite_failures = sprite_stats.failures, sprite_deferred = sprite_stats.deferred or 0,
        sprite_capacity = SPRITE_CAPACITY, collection_capacity = COLLECTION_CAPACITY,
        camera_zoom = CAMERA.zoom, visible_tiles_width = VIEW_WIDTH_TILES,
        visible_tiles_height = VIEW_HEIGHT_TILES,
        npc_path_next = npc_next and string.format("%d,%d,%d", npc_next.x, npc_next.y, npc_next.z) or "none",
        player_health = string.format("%d/%d", player_combat.health, player_combat.max_health),
        rat_health = string.format("%d/%d", rat_combat.health, rat_combat.max_health), rat_dead = rat_combat.dead,
        rat_definition = rat_definition, rat_type = rat.type,
        villager_definition = villager_definition, villager_type = villager.type,
        player_faction = player_faction, rat_faction = rat_faction, villager_faction = villager_faction,
        rat_relationship = rat_relationship, villager_relationship = villager_relationship,
        dialogue_active = conversation ~= nil, dialogue_text = dialogue_text,
        dialogue_speaker = conversation and conversation.npc_actor_id or "none",
        dialogue_definition = conversation and conversation.dialogue_id or "none",
        dialogue_node = conversation and conversation.node_id or "none",
        test_dialogue_flag = state_api.get_flag(self.state, TEST_DIALOGUE_FLAG),
        met_villager_flag = state_api.get_flag(self.state, MET_VILLAGER_FLAG),
        quest_title = quest_definition.title, quest_status = quest_status,
        quest_progress = quest_progress, quest_target = quest_definition.objectives[1].target,
        last_binding = last_binding and (last_binding.binding_id .. " = "
            .. (last_binding.success and "success" or (last_binding.failure and last_binding.failure.reason or "failed")))
            or "none",
        rat_sight = rat_perception and rat_perception.sight_range or 0,
        rat_perceives = describe_perception(rat_awareness.perceived),
        player_attack = player_damage.damage, player_attack_source = player_damage.source,
        player_weapon = player_damage.item_type and (player_damage.item_type .. " [" .. player_damage.item_id .. "]") or "none",
        player_attack_cooldown = player_attack.cooldown_remaining, player_armor = player_armor.armor,
        player_armor_sources = #armor_sources > 0 and table.concat(armor_sources, ",") or "none",
        last_attack = last_attack and string.format("raw %d - armor %d = %d",
            last_attack.raw_damage, last_attack.armor, last_attack.damage) or "none" }
    msg.post("#world_sprite_renderer", "render_world")
    msg.post("#view", "render_world")
end

local function create_session(self, map, loaded)
    if self.event_bindings then event_bindings.destroy(self.event_bindings); self.event_bindings = nil end
    if self.item_selection then item_selection.clear(self.item_selection) end
    if self.item_drag then item_drag.cancel(self.item_drag) end
    self.map = map
    self.state = state_api.new(loaded)
    self.item_registry = item_registry_api.new(item_definitions)
    self.world = world_api.new(self.map, registry_api.new(definitions), self.state, self.item_registry)
    if loaded then save_data.apply_static_item_overrides(self.world, loaded) end
    local spawn = self.map.player_spawn
    self.player = player_api.new(spawn.x, spawn.y, spawn.z)
    self.player.inventory = loaded and save_data.restore_inventory(loaded, self.item_registry)
        or inventory_api.restore(self.map.player_inventory, self.item_registry)
    self.player.equipment = loaded and save_data.restore_equipment(loaded, self.item_registry)
        or equipment_api.restore(self.map.player_equipment, self.item_registry)
    if loaded then
        save_data.restore_dynamic_world_items(self.world, loaded)
        self.item_ids = save_data.create_item_id_allocator(loaded, self.map)
    else self.item_ids = save_data.create_fresh_item_id_allocator(self.map) end
    self.player.facing = spawn.facing or self.player.facing
    if loaded then save_data.restore_player(self.player, loaded) end
    movement.reset(self.player); movement.configure(self.player, { speed = 7 })
    self.world:place_actor(self.player)
    self.combat = combat_registry.create(self.world, events)
    local saved_combat = loaded and save_data.restore_player_combat(loaded) or nil
    assert(combat_registry.add(self.combat, self.player.id,
        saved_combat and saved_combat.max_health or self.map.player_max_health,
        saved_combat and saved_combat.health or nil))
    self.attacks = attacks.create(self.world, self.combat, events, self.item_registry)
    assert(attacks.add_profile(self.attacks, self.player.id, self.map.player_attack))
    assert(attacks.set_equipment(self.attacks, self.player.id, self.player.equipment))
    self.faction_registry = faction_registry_api.new(faction_definitions, relationship_definitions)
    self.factions = factions.create(self.world, self.faction_registry)
    assert(factions.associate(self.factions, self.player.id, "player"))
    self.perception = perception.create(self.world, self.combat, self.factions)
    self.quest_registry = quest_registry_api.new(quest_definitions)
    self.quests = quests.create(self.quest_registry, events, loaded and save_data.restore_quests(loaded) or nil)
    self.dialogue_registry = dialogue_registry_api.new(dialogue_definitions, self.quest_registry)
    self.creature_registry = creature_registry_api.new(creature_definitions, self.faction_registry,
        self.dialogue_registry)
    self.creatures = creatures.create(self.world, self.creature_registry, self.combat, self.attacks, events,
        self.factions, self.perception)
    for _, placement in ipairs(self.map.actor_placements or {}) do
        creatures.spawn(self.creatures, placement)
    end
    self.binding_registry = binding_registry_api.new(binding_definitions, self.creature_registry,
        self.quest_registry)
    self.event_bindings = event_bindings.create(self.binding_registry, events, self.world, self.creatures,
        { world_state = self.state, quests = self.quests, quest_registry = self.quest_registry })
    self.dialogue = dialogue.create(self.world, self.dialogue_registry, self.creatures, self.combat, events,
        self.quests, self.quest_registry)
    actions.register_defaults({ dialogue = self.dialogue })
    self.path_controller = movement_controller.create(self.world, events)
    self.last_attack = nil
    self.interior_group = roofs.interior_group(self.world, self.player.position)
end

local function load_game(self)
    local map = map_loader.load("data.maps.prototype")
    local loaded, reason = save_manager.load(map)
    if not loaded then self.notice = "Load: " .. reason; return false end
    create_session(self, map, loaded); self.notice = "Save loaded"; events.emit("game_loaded", { map_id = self.map.id })
    return true
end

local function update_interior(self)
    local current = roofs.interior_group(self.world, self.player.position)
    if current ~= self.interior_group then
        if self.interior_group then events.emit("player_left_interior", { actor_id = self.player.id, interior_group = self.interior_group }) end
        if current then events.emit("player_entered_interior", { actor_id = self.player.id, interior_group = current }) end
        self.interior_group = current
    end
end

function init(self)
    msg.post(".", "acquire_input_focus")
    self.held, self.debug_visible, self.inspect_offset = {}, false, 0
    self.pointer, self.last_ui_intent = { region = "outside" }, nil
    self.item_selection = item_selection.create()
    self.item_drag = item_drag.create()
    local map = map_loader.load("data.maps.prototype")
    create_session(self, map, save_manager.load(map))
    events.emit("world_loaded", { map_id = self.map.id })
    render(self)
end

function update(self, dt)
    local moving = attacks.update(self.attacks, dt)
    if movement.update(self.player, dt) then moving = true end
    if movement_controller.update(self.path_controller, dt) then moving = true end
    if not dialogue.is_active(self.dialogue) and not movement.is_moving(self.player) then
        local dx = (self.held.right and 1 or 0) - (self.held.left and 1 or 0)
        local dy = (self.held.up and 1 or 0) - (self.held.down and 1 or 0)
        if dx ~= 0 then dy = 0 end
        if movement.begin(self.world, self.player, dx, dy, events) then moving = true; update_interior(self) end
    end
    if moving then render(self) end
end

function on_input(self, action_id, action)
    -- Defold reports unbound mouse motion with a nil action ID. Only buttons
    -- belong in game.input_binding; mouse_movement is not a valid DDF field.
    local mouse_motion = action_id == nil and action.x ~= nil and action.y ~= nil
    if mouse_motion or action_id == hash("left_click") then
        local width, height = window.get_size()
        local context = {
            equipment = equipment_panel.snapshot(self.player.equipment, self.item_registry),
            inventory = inventory_panel.snapshot(self.player.inventory, self.item_registry),
        }
        -- screen_x/screen_y are Defold's unadjusted bottom-left physical coordinates.
        local physical_x, physical_y = action.screen_x or action.x, action.screen_y or action.y
        self.pointer = input_dispatch.resolve_physical(layout.physical_transform(width, height),
            physical_x, physical_y, context)
        local dialogue_active = dialogue.is_active(self.dialogue)
        if action_id == hash("left_click") and action.pressed then
            self.pointer_press_target = self.pointer.target
            if not dialogue_active then
                item_drag.pointer_down(self.item_drag, self.pointer.target,
                    self.pointer.virtual_x, self.pointer.virtual_y)
            end
            render(self)
            return self.pointer.target ~= nil
        elseif mouse_motion and item_drag.is_pending(self.item_drag) then
            local source = item_drag.get_source(self.item_drag)
            local target = input_dispatch.drop_target(self.pointer.virtual_x, self.pointer.virtual_y,
                context, source.type)
            local drop_intent = { type = "drop_item", item_id = source.item_id,
                item_type = source.item_type, source = source, target = target }
            local validation = equipment_controller.validate_drop(drop_intent, {
                equipment = self.player.equipment, inventory = self.player.inventory,
                item_registry = self.item_registry,
            })
            local was_active = item_drag.is_active(self.item_drag)
            item_drag.pointer_move(self.item_drag, self.pointer.virtual_x, self.pointer.virtual_y,
                target, validation)
            if not was_active and item_drag.is_active(self.item_drag) then
                item_selection.select_target(self.item_selection, self.pointer_press_target)
            end
            render(self)
            return true
        elseif action_id == hash("left_click") and action.released then
            local source = item_drag.get_source(self.item_drag)
            if item_drag.is_active(self.item_drag) then
                local target = input_dispatch.drop_target(self.pointer.virtual_x, self.pointer.virtual_y,
                    context, source.type)
                local validation = equipment_controller.validate_drop({ type = "drop_item",
                    item_id = source.item_id, item_type = source.item_type, source = source, target = target }, {
                    equipment = self.player.equipment, inventory = self.player.inventory,
                    item_registry = self.item_registry,
                })
                item_drag.pointer_move(self.item_drag, self.pointer.virtual_x, self.pointer.virtual_y,
                    target, validation)
                local drop_intent = item_drag.release(self.item_drag)
                local result = equipment_controller.handle_drop(drop_intent, {
                    equipment = self.player.equipment, inventory = self.player.inventory,
                    item_registry = self.item_registry, events = events,
                })
                if result.success then
                    local verb = result.action == "equip" and "Equipped " or "Unequipped "
                    self.notice = verb .. self.item_registry:get(result.item_type).name .. "."
                elseif result.reason == "incompatible_slot" then
                    self.notice = "That item cannot be equipped there."
                elseif result.reason == "slot_occupied" then
                    self.notice = "The required equipment slot is occupied."
                elseif result.reason == "inventory_full" then self.notice = "Inventory is full." end
                render(self)
                return true
            end
            if item_drag.is_pending(self.item_drag) then item_drag.release(self.item_drag) end
            local target = self.pointer.target
            local intent = target and { type = "ui_click", target = target, blocked = dialogue_active } or nil
            if intent then self.last_ui_intent = intent end
            local activate = false
            if intent and intent.blocked then item_selection.clear(self.item_selection)
            elseif intent then activate = item_selection.click_target(self.item_selection, intent.target) end
            local result = { handled = false, success = false }
            if activate then
                result = equipment_controller.handle_intent(intent, {
                    equipment = self.player.equipment, inventory = self.player.inventory,
                    item_registry = self.item_registry, events = events,
                })
            end
            if result.handled and result.success then
                local verb = result.action == "equip" and "Equipped " or "Unequipped "
                self.notice = verb .. self.item_registry:get(result.item_type).name .. "."
            elseif result.handled and result.reason == "inventory_full" then
                self.notice = "Inventory is full."
            elseif result.handled and result.reason == "not_equippable" then
                self.notice = "That item cannot be equipped."
            elseif result.handled and result.reason == "slot_occupied" then
                self.notice = "The required equipment slot is occupied."
            end
            render(self)
            self.pointer_press_target = nil
            if target then return true end
        else
            render(self)
            return item_drag.is_pending(self.item_drag) or self.pointer.target ~= nil
        end
    end
    if action.pressed and action_id == hash("dialogue_close") and item_drag.is_pending(self.item_drag) then
        item_drag.cancel(self.item_drag); self.notice = "Drag cancelled"; render(self); return true
    end
    if dialogue.is_active(self.dialogue) then
        if action.pressed and action_id == hash("debug") then
            self.debug_visible = not self.debug_visible; render(self); return true
        end
        local choices = { [hash("dialogue_1")] = 1, [hash("dialogue_2")] = 2,
            [hash("dialogue_3")] = 3, [hash("dialogue_4")] = 4 }
        if action.pressed and choices[action_id] then
            local changed, reason = dialogue.choose_index(self.dialogue, choices[action_id])
            local failure = type(reason) == "table" and reason.reason or reason
            self.notice = changed and "Dialogue choice selected" or ("Dialogue: " .. tostring(failure))
            render(self); return true
        elseif action.pressed and action_id == hash("dialogue_close") then
            dialogue.close(self.dialogue, "cancelled"); self.notice = "Dialogue closed"; render(self); return true
        end
        return true
    end
    local directions = { [hash("up")] = "up", [hash("down")] = "down", [hash("left")] = "left", [hash("right")] = "right" }
    local direction = directions[action_id]
    if direction then
        if action.pressed or action.repeated then self.held[direction] = true end
        if action.released then self.held[direction] = nil end
        return true
    elseif action.pressed and action_id == hash("interact") then
        local changed, reason = interaction.use(self.world, self.player, events)
        if dialogue.is_active(self.dialogue) then self.held = {} end
        self.notice = changed and "Interaction used" or reason; update_interior(self); render(self); return true
    elseif action.pressed and action_id == hash("debug") then
        self.debug_visible = not self.debug_visible; render(self); return true
    elseif action.pressed and action_id == hash("debug_npc_path") then
        local npc_id = "npc_test_villager"
        local result = pathfinding.find_path(self.world, npc_id, { x = 14, y = 7, z = 7 })
        local assigned, reason = false, result.reason
        if result.success then assigned, reason = movement_controller.set_path(self.path_controller, npc_id, result.path) end
        self.notice = assigned and ("NPC path started: " .. #result.path .. " steps")
            or ("NPC path: " .. tostring(reason))
        render(self); return true
    elseif action.pressed and action_id == hash("debug_damage") then
        local result = combat_registry.apply_damage(self.combat, "monster_test_rat", 5,
            { source = "development_control" })
        self.notice = result.success and ("Rat damage: 5, HP " .. result.health)
            or ("Rat damage: " .. result.reason)
        render(self); return true
    elseif action.pressed and action_id == hash("attack") then
        local dx, dy = movement.facing_offset(self.player.facing)
        local target = self.world:get_actor_at(self.player.position.x + dx, self.player.position.y + dy,
            self.player.position.z)
        local result = target and attacks.try_attack(self.attacks, self.player.id, target.id)
            or { success = false, reason = "no_target" }
        if result.success then self.last_attack = result end
        self.notice = result.success and string.format("Attack: %d damage, target HP %d",
            result.damage, result.target_health) .. " (" .. result.damage_source .. ")" or ("Attack: " .. result.reason)
        render(self); return true
    elseif action.pressed and action_id == hash("debug_toggle_weapon") then
        local equipped = equipment_api.get(self.player.equipment, "main_hand")
        local changed, reason, item
        if equipped then
            changed, item = equipment_api.unequip(self.player.equipment, self.player.inventory, "main_hand", events)
            reason = changed and nil or item
        else
            for _, candidate in ipairs(inventory_api.get_items(self.player.inventory)) do
                local definition = self.item_registry:get(candidate.type)
                if definition.weapon then item = candidate; break end
            end
            if item then changed, reason = equipment_api.equip(self.player.equipment, self.player.inventory,
                item.id, "main_hand", events)
            else changed, reason = false, "no_main_hand_weapon" end
        end
        self.notice = changed and (equipped and "Weapon unequipped" or "Weapon equipped")
            or ("Weapon: " .. tostring(reason))
        render(self); return true
    elseif action.pressed and action_id == hash("debug_toggle_armor") then
        local equipped = equipment_api.get(self.player.equipment, "torso")
        local changed, reason, item
        if equipped then
            changed, item = equipment_api.unequip(self.player.equipment, self.player.inventory, "torso", events)
            reason = changed and nil or item
        else
            for _, candidate in ipairs(inventory_api.get_items(self.player.inventory)) do
                local definition = self.item_registry:get(candidate.type)
                if definition.armor then
                    local allowed = equipment_api.can_equip(self.player.equipment, candidate, "torso")
                    if allowed then item = candidate; break end
                end
            end
            if item then changed, reason = equipment_api.equip(self.player.equipment, self.player.inventory,
                item.id, "torso", events)
            else changed, reason = false, "no_torso_armor" end
        end
        self.notice = changed and (equipped and "Armor unequipped" or "Armor equipped")
            or ("Armor: " .. tostring(reason))
        render(self); return true
    elseif action.pressed and action_id == hash("debug_rat_attack") then
        local result = attacks.try_attack(self.attacks, "monster_test_rat", self.player.id)
        if result.success then self.last_attack = result end
        self.notice = result.success and string.format("Rat attack: raw %d, armor %d, damage %d",
            result.raw_damage, result.armor, result.damage) or ("Rat attack: " .. result.reason)
        render(self); return true
    elseif action.pressed and action_id == hash("debug_rat_perception") then
        local awareness = perception.get_awareness(self.perception, "monster_test_rat")
        self.notice = "Rat perceives: " .. describe_perception(awareness.perceived)
        render(self); return true
    elseif action.pressed and action_id == hash("debug_toggle_dialogue_flag") then
        local value = not state_api.get_flag(self.state, TEST_DIALOGUE_FLAG)
        state_api.set_flag(self.state, TEST_DIALOGUE_FLAG, value)
        self.notice = "Dialogue flag: " .. tostring(value)
        render(self); return true
    elseif action.pressed and action_id == hash("debug_quest_start") then
        local changed, reason = quests.start(self.quests, "rat_problem")
        self.notice = changed and "Quest started" or ("Quest start: " .. tostring(reason))
        render(self); return true
    elseif action.pressed and action_id == hash("debug_quest_advance") then
        local changed, reason = quests.advance_objective(self.quests, "rat_problem", "investigate", 1)
        self.notice = changed and "Quest objective advanced" or ("Quest advance: " .. tostring(reason))
        render(self); return true
    elseif action.pressed and action_id == hash("debug_quest_complete") then
        local changed, reason = quests.complete(self.quests, "rat_problem")
        self.notice = changed and "Quest completed" or ("Quest complete: " .. tostring(reason))
        render(self); return true
    elseif action.pressed and action_id == hash("drop_item") then
        local first = inventory_api.get_items(self.player.inventory)[1]
        if not first then self.notice = "Drop: inventory empty"
        else
            local dropped, reason = item_transfers.drop(self.world, self.player.inventory, first.id,
                self.player.position, self.player.id, events)
            self.notice = dropped and ("Dropped " .. dropped.item.type) or ("Drop: " .. reason)
        end
        render(self); return true
    elseif action.pressed and action_id == hash("save") then
        item_drag.cancel(self.item_drag)
        self.notice = save_manager.save(self.player, self.world, self.map.id,
            combat_registry.get(self.combat, self.player.id), quests.get_snapshot(self.quests))
            and "Game saved" or "Save failed"; render(self); return true
    elseif action.pressed and action_id == hash("load") then load_game(self); render(self); return true
    elseif action.pressed and action_id == hash("reset_save") then
        save_manager.reset(); create_session(self, map_loader.load("data.maps.prototype"), nil)
        self.notice = "Save reset"; render(self); return true
    elseif action.pressed and (action_id == hash("inspect_up") or action_id == hash("inspect_down")) then
        self.inspect_offset = action_id == hash("inspect_up") and 1 or -1; render(self); return true
    elseif action.released and (action_id == hash("inspect_up") or action_id == hash("inspect_down")) then
        self.inspect_offset = 0; render(self); return true
    end
end

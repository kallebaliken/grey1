[project]
title = Greyhaven
version = 0.1.0

[bootstrap]
main_collection = /main/main.collectionc

[display]
width = 960
height = 640
high_dpi = 1

[input]
game_binding = /input/game.input_bindingc

[script]
shared_state = 1

[collection]
max_instances = 4096

[sprite]
max_count = 2048

[graphics]
default_texture_min_filter = nearest
default_texture_mag_filter = nearest

[greyhaven]
camera_zoom = 2
